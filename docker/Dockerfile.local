# Simplified Dockerfile for local testing (no heredoc, no cross-compilation)
FROM rust:1-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config make jq curl git \
    clang llvm-dev libclang-dev lld \
    liburing-dev libsystemd-dev \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang
ENV CXX=clang++

WORKDIR /app
COPY . .

RUN cargo build --release \
    --no-default-features \
    --features "default" \
    && cp target/release/conduwuit /usr/local/bin/conduwuit

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates liburing2 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/conduwuit /sbin/conduwuit

EXPOSE 8008

CMD ["/sbin/conduwuit"]
