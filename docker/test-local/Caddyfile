# Matrix homeserver + Cinny client
localhost {
    tls /certs/localhost+2.pem /certs/localhost+2-key.pem

    # Matrix client-server API → Continuwuity
    handle /_matrix/* {
        reverse_proxy continuwuity:8008
    }

    # Continuwuity internal endpoints (SSO callback, OIDC server)
    handle /_continuwuity/* {
        reverse_proxy continuwuity:8008
    }

    # Well-known endpoints → Continuwuity
    handle /.well-known/* {
        reverse_proxy continuwuity:8008
    }

    # Everything else → Cinny
    handle {
        reverse_proxy cinny:80
    }
}

# Rauthy identity provider
localhost:8443 {
    tls /certs/localhost+2.pem /certs/localhost+2-key.pem

    reverse_proxy rauthy:8443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}
